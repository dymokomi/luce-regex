#==============================================================================================
#
#   regex - a small regular-expression engine
#
#   DESCRIPTION:
#       A from-scratch matcher covering the Oniguruma subset that TextMate grammars use, so
#       highlighting needs no external regex. A pattern is parsed to an AST and matched by
#       backtracking. The subject is a sequence of Unicode scalars (one-scalar strings) compared
#       in scalar-value order, exactly how the editor counts offsets. A step budget bounds
#       pathological patterns rather than letting them hang. Depends only on the prelude.
#
#       Supported: literals, `.`, classes ([...], ranges, negation, \d \w \s and negated forms,
#       a POSIX subset), anchors (^ $ \b \B \A \G \z \Z), groups (capturing, (?:), named), the
#       alternation `|`, quantifiers (* + ? {n} {n,} {n,m}, greedy and lazy), backreferences
#       (numeric and named), lookahead and lookbehind, case-insensitive matching, and the inline
#       flags (?i) (?x) (?s) (?m). Rare features degrade rather than fail (see README).
#
#==============================================================================================

## A pattern the engine could not parse.
pub let syntax_error: ErrorCode = ErrorCode.package(330)

# mark: Node kinds and constants ==============================================================

let K_EMPTY = 0
let K_CHAR = 1
let K_ANY = 2
let K_CLASS = 3
let K_ANCHOR = 4
let K_CONCAT = 5
let K_ALT = 6
let K_REPEAT = 7
let K_GROUP = 8
let K_BACKREF = 9
let K_LOOK = 10
let K_CLOSE = 11
let K_ENDAT = 12
let K_PROGRESS = 13

let AN_BOL = 0
let AN_EOL = 1
let AN_WORDB = 2
let AN_NWORDB = 3
let AN_BUFS = 4
let AN_G = 5
let AN_BUFE = 6

let digits10 = "0123456789"
let UPPER = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
let LOWER = "abcdefghijklmnopqrstuvwxyz"
let ASCII_PRINT = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

# mark: The AST and continuation ==============================================================

## One AST node. Fields are reused across kinds: `a` holds a group index, anchor kind, backref
## index or repeat minimum; `b` a repeat maximum (-1 = unbounded). `kids` are the children.
class Node:
    var kind: int
    var text: str
    var a: int
    var b: int
    var greedy: bool
    var ahead: bool
    var negate: bool
    var kids: list[Node]
    var ranges: list[str]
    var builtins: str

    func init(self, kind: int, text: str = "", a: int = 0, b: int = 0, greedy: bool = true, ahead: bool = true, negate: bool = false):
        self.kind = kind
        self.text = text
        self.a = a
        self.b = b
        self.greedy = greedy
        self.ahead = ahead
        self.negate = negate
        self.kids = []
        self.ranges = []
        self.builtins = ""

## A match continuation: match `node` (with `count` for repeat/assert frames), then `next`.
## Represented as data because Luce has no closures.
class Cont:
    let node: Node
    let count: int
    let next: Cont?

    func init(self, node: Node, count: int, next: Cont?):
        self.node = node
        self.count = count
        self.next = next

# mark: A match result ========================================================================

## The spans of a successful match: group 0 is the whole match; higher indices are capturing
## groups, and an unset group reports -1. Offsets are scalar indices into the subject.
pub class Match:
    let caps: list[int]
    let names: map[str, int]

    func init(self, caps: list[int], names: map[str, int]):
        self.caps = caps
        self.names = names

    pub func start(self) -> int:
        return self.caps[0]

    pub func finish(self) -> int:
        return self.caps[1]

    pub func group_count(self) -> int:
        return self.caps.length // 2

    pub func group_start(self, index: int) -> int:
        if index >= 0 and 2 * index + 1 < self.caps.length:
            return self.caps[2 * index]
        return -1

    pub func group_end(self, index: int) -> int:
        if index >= 0 and 2 * index + 1 < self.caps.length:
            return self.caps[2 * index + 1]
        return -1

    ## The index of a named group, or -1 when the pattern has no such name.
    pub func group_of(self, name: str) -> int:
        return self.names[name] else -1

# mark: The engine ============================================================================

pub class Regex:
    var pat: list[str]
    var pp: int
    var ngroups: int
    var names: map[str, int]
    var ic: bool
    var ext: bool
    var dotall: bool
    var multi: bool
    var root: Node
    var closers: list[Node]
    var prog: Node
    var endat: Node
    var subj: list[str]
    var len: int
    var anchor: int
    var caps: list[int]
    var steps: int
    var budget: int

    ## Compile `pattern`. `ignore_case` starts the whole pattern case-insensitive; an inline
    ## `(?i)` has the same effect. A malformed pattern fails with `syntax_error`.
    pub func init(self, pattern: str, ignore_case: bool = false) -> unit!:
        self.pat = []
        for ch in pattern:
            self.pat.append(ch)
        self.pp = 0
        self.ngroups = 0
        self.names = {}
        self.ic = ignore_case
        self.ext = false
        self.dotall = false
        self.multi = false
        self.subj = []
        self.len = 0
        self.anchor = 0
        self.steps = 0
        self.budget = 200000
        self.root = Node(K_EMPTY)
        self.prog = Node(K_PROGRESS)
        self.endat = Node(K_ENDAT)
        self.closers = []
        self.caps = []
        self.root = try self.parse_alt()
        if self.pp < self.pat.length:
            error(syntax_error, "unexpected '" + self.pat[self.pp] + "' in pattern")
        var i = 0
        while i <= self.ngroups:
            self.closers.append(Node(K_CLOSE, a = i))
            i += 1
        var k = 0
        while k < 2 * (self.ngroups + 1):
            self.caps.append(-1)
            k += 1

    # -- parser --------------------------------------------------------------------------------

    func parse_alt(self) -> Node!:
        var branches: list[Node] = []
        branches.append(try self.parse_concat())
        while self.pp < self.pat.length and self.pat[self.pp] == "|":
            self.pp += 1
            branches.append(try self.parse_concat())
        if branches.length == 1:
            return branches[0]
        let node = Node(K_ALT)
        node.kids = branches
        return node

    func parse_concat(self) -> Node!:
        var parts: list[Node] = []
        while true:
            if self.ext:
                self.skip_ws()
            if self.pp >= self.pat.length:
                break
            let ch = self.pat[self.pp]
            if ch == "|" or ch == ")":
                break
            parts.append(try self.parse_repeat())
        if parts.length == 0:
            return Node(K_EMPTY)
        if parts.length == 1:
            return parts[0]
        let node = Node(K_CONCAT)
        node.kids = parts
        return node

    func parse_repeat(self) -> Node!:
        let atom = try self.parse_atom()
        if self.ext:
            self.skip_ws()
        if self.pp >= self.pat.length:
            return atom
        let ch = self.pat[self.pp]
        var lo = 0
        var hi = 0
        var has = false
        if ch == "*":
            lo = 0
            hi = -1
            has = true
            self.pp += 1
        elif ch == "+":
            lo = 1
            hi = -1
            has = true
            self.pp += 1
        elif ch == "?":
            lo = 0
            hi = 1
            has = true
            self.pp += 1
        elif ch == "{":
            let saved = self.pp
            self.pp += 1
            var mins = ""
            while self.pp < self.pat.length and is_digit(self.pat[self.pp]):
                mins += self.pat[self.pp]
                self.pp += 1
            if mins == "":
                self.pp = saved
                return atom
            var maxs = mins
            var comma = false
            if self.pp < self.pat.length and self.pat[self.pp] == ",":
                comma = true
                self.pp += 1
                maxs = ""
                while self.pp < self.pat.length and is_digit(self.pat[self.pp]):
                    maxs += self.pat[self.pp]
                    self.pp += 1
            if self.pp < self.pat.length and self.pat[self.pp] == "}":
                self.pp += 1
                lo = to_int(mins)
                hi = lo
                if comma:
                    hi = -1 if maxs == "" else to_int(maxs)
                has = true
            else:
                self.pp = saved
                return atom
        if not has:
            return atom
        var greedy = true
        if self.pp < self.pat.length and self.pat[self.pp] == "?":
            greedy = false
            self.pp += 1
        elif self.pp < self.pat.length and self.pat[self.pp] == "+":
            self.pp += 1
        let node = Node(K_REPEAT, a = lo, b = hi, greedy = greedy)
        node.kids = [atom]
        return node

    func parse_atom(self) -> Node!:
        if self.ext:
            self.skip_ws()
        if self.pp >= self.pat.length:
            return Node(K_EMPTY)
        let ch = self.pat[self.pp]
        if ch == "(":
            return try self.parse_group()
        if ch == "[":
            return try self.parse_class()
        if ch == ".":
            self.pp += 1
            return Node(K_ANY)
        if ch == "^":
            self.pp += 1
            return Node(K_ANCHOR, a = AN_BOL)
        if ch == "$":
            self.pp += 1
            return Node(K_ANCHOR, a = AN_EOL)
        if ch == "\\":
            return try self.parse_escape()
        self.pp += 1
        return Node(K_CHAR, text = ch)

    func parse_group(self) -> Node!:
        self.pp += 1
        if self.pp < self.pat.length and self.pat[self.pp] == "?":
            self.pp += 1
            let c = self.pat[self.pp] if self.pp < self.pat.length else ""
            if c == ":":
                self.pp += 1
                return try self.grouped(0)
            if c == "=":
                self.pp += 1
                return try self.parse_look(true, false)
            if c == "!":
                self.pp += 1
                return try self.parse_look(true, true)
            if c == ">":
                self.pp += 1
                return try self.grouped(0)
            if c == "<":
                self.pp += 1
                let d = self.pat[self.pp] if self.pp < self.pat.length else ""
                if d == "=":
                    self.pp += 1
                    return try self.parse_look(false, false)
                if d == "!":
                    self.pp += 1
                    return try self.parse_look(false, true)
                let name = try self.read_name(">")
                return try self.parse_named(name)
            if c == "'":
                self.pp += 1
                let name = try self.read_name("'")
                return try self.parse_named(name)
            return try self.parse_flags()
        self.ngroups += 1
        let index = self.ngroups
        return try self.grouped(index)

    func grouped(self, index: int) -> Node!:
        let inner = try self.parse_alt()
        try self.expect(")")
        let node = Node(K_GROUP, a = index)
        node.kids = [inner]
        return node

    func parse_named(self, name: str) -> Node!:
        self.ngroups += 1
        let index = self.ngroups
        self.names[name] = index
        return try self.grouped(index)

    func parse_look(self, ahead: bool, negate: bool) -> Node!:
        let inner = try self.parse_alt()
        try self.expect(")")
        let node = Node(K_LOOK, ahead = ahead, negate = negate)
        node.kids = [inner]
        return node

    func parse_flags(self) -> Node!:
        var on = true
        while self.pp < self.pat.length:
            let c = self.pat[self.pp]
            if c == ":" or c == ")":
                break
            if c == "-":
                on = false
            elif c == "i":
                if on:
                    self.ic = true
            elif c == "s":
                if on:
                    self.dotall = true
            elif c == "m":
                if on:
                    self.multi = true
            elif c == "x":
                self.ext = on
            self.pp += 1
        if self.pp < self.pat.length and self.pat[self.pp] == ":":
            self.pp += 1
            return try self.grouped(0)
        try self.expect(")")
        return Node(K_EMPTY)

    func parse_escape(self) -> Node!:
        self.pp += 1
        if self.pp >= self.pat.length:
            return Node(K_CHAR, text = "\\")
        let c = self.pat[self.pp]
        self.pp += 1
        if c in ["d", "D", "w", "W", "s", "S", "h", "H"]:
            let node = Node(K_CLASS)
            node.builtins = c
            return node
        if c == "b":
            return Node(K_ANCHOR, a = AN_WORDB)
        if c == "B":
            return Node(K_ANCHOR, a = AN_NWORDB)
        if c == "A":
            return Node(K_ANCHOR, a = AN_BUFS)
        if c == "G":
            return Node(K_ANCHOR, a = AN_G)
        if c == "z" or c == "Z":
            return Node(K_ANCHOR, a = AN_BUFE)
        if is_digit(c) and c != "0":
            var ds = c
            while self.pp < self.pat.length and is_digit(self.pat[self.pp]):
                ds += self.pat[self.pp]
                self.pp += 1
            return Node(K_BACKREF, a = to_int(ds))
        if c == "k" and self.pp < self.pat.length and (self.pat[self.pp] == "<" or self.pat[self.pp] == "'"):
            let term = ">" if self.pat[self.pp] == "<" else "'"
            self.pp += 1
            let name = try self.read_name(term)
            return Node(K_BACKREF, a = self.names[name] else 0)
        if c == "p" or c == "P":
            let node = Node(K_CLASS)
            node.negate = c == "P"
            self.add_property(node, self.read_property())
            return node
        return Node(K_CHAR, text = self.decode_escape(c))

    func parse_class(self) -> Node!:
        self.pp += 1
        let node = Node(K_CLASS)
        if self.pp < self.pat.length and self.pat[self.pp] == "^":
            node.negate = true
            self.pp += 1
        var first = true
        while self.pp < self.pat.length:
            let ch = self.pat[self.pp]
            if ch == "]" and not first:
                break
            first = false
            if ch == "[" and self.pp + 1 < self.pat.length and self.pat[self.pp + 1] == ":":
                self.parse_posix(node)
                continue
            if ch == "\\":
                let lit = self.class_escape(node)
                if lit != "":
                    self.maybe_range(node, lit)
                continue
            self.pp += 1
            self.maybe_range(node, ch)
        try self.expect("]")
        return node

    func maybe_range(self, node: Node, lo: str) -> unit:
        if self.pp < self.pat.length and self.pat[self.pp] == "-" and self.pp + 1 < self.pat.length and self.pat[self.pp + 1] != "]":
            self.pp += 1
            var hi = ""
            if self.pat[self.pp] == "\\":
                hi = self.class_escape_char()
            else:
                hi = self.pat[self.pp]
                self.pp += 1
            node.ranges.append(lo)
            node.ranges.append(hi)
        else:
            node.ranges.append(lo)
            node.ranges.append(lo)

    func class_escape(self, node: Node) -> str:
        self.pp += 1
        if self.pp >= self.pat.length:
            return "\\"
        let c = self.pat[self.pp]
        self.pp += 1
        if c in ["d", "D", "w", "W", "s", "S", "h", "H"]:
            node.builtins += c
            return ""
        if c == "p" or c == "P":
            let sub = Node(K_CLASS)
            self.add_property(sub, self.read_property())
            node.builtins += sub.builtins
            var r = 0
            while r < sub.ranges.length:
                node.ranges.append(sub.ranges[r])
                r += 1
            return ""
        return self.decode_escape(c)

    func class_escape_char(self) -> str:
        self.pp += 1
        if self.pp >= self.pat.length:
            return "\\"
        let c = self.pat[self.pp]
        self.pp += 1
        return self.decode_escape(c)

    ## The literal scalar a simple escape denotes (used for range ends and inside classes).
    func decode_escape(self, c: str) -> str:
        if c == "n":
            return "\n"
        if c == "t":
            return "\t"
        if c == "r":
            return "\r"
        if c == "f":
            return cp_to_str(12)
        if c == "v":
            return cp_to_str(11)
        if c == "0":
            return cp_to_str(0)
        if c == "a":
            return cp_to_str(7)
        if c == "e":
            return cp_to_str(27)
        if c == "b":
            return cp_to_str(8)
        if c == "x":
            return self.read_hex(2)
        if c == "u":
            return self.read_hex(4)
        return c

    func parse_posix(self, node: Node) -> unit:
        self.pp += 2
        var name = ""
        while self.pp < self.pat.length and self.pat[self.pp] != ":":
            name += self.pat[self.pp]
            self.pp += 1
        if self.pp < self.pat.length:
            self.pp += 1
        if self.pp < self.pat.length:
            self.pp += 1
        self.add_property(node, name)

    func read_property(self) -> str:
        var name = ""
        if self.pp < self.pat.length and self.pat[self.pp] == "{":
            self.pp += 1
            while self.pp < self.pat.length and self.pat[self.pp] != "}":
                name += self.pat[self.pp]
                self.pp += 1
            if self.pp < self.pat.length:
                self.pp += 1
        elif self.pp < self.pat.length:
            name = self.pat[self.pp]
            self.pp += 1
        return name

    ## Map a POSIX or Unicode property name to an ASCII approximation. Never fails: an unknown
    ## name falls back to the word set, so an exotic grammar still loads.
    func add_property(self, node: Node, name: str) -> unit:
        if name in ["digit", "Digit", "Nd", "N", "Number"]:
            node.builtins += "d"
        elif name in ["space", "Space", "White_Space", "s"]:
            node.builtins += "s"
        elif name in ["xdigit", "XDigit"]:
            node.builtins += "h"
        elif name in ["upper", "Upper", "Lu"]:
            node.ranges.append("A")
            node.ranges.append("Z")
        elif name in ["lower", "Lower", "Ll"]:
            node.ranges.append("a")
            node.ranges.append("z")
        elif name in ["alpha", "Alpha", "Alphabetic", "L", "Letter"]:
            node.ranges.append("A")
            node.ranges.append("Z")
            node.ranges.append("a")
            node.ranges.append("z")
        elif name in ["alnum", "Alnum"]:
            node.builtins += "d"
            node.ranges.append("A")
            node.ranges.append("Z")
            node.ranges.append("a")
            node.ranges.append("z")
        elif name in ["punct", "Punct"]:
            self.append_range(node, "!", "/")
            self.append_range(node, ":", "@")
            self.append_range(node, "[", "`")
            self.append_range(node, "{", "~")
        else:
            node.builtins += "w"

    func append_range(self, node: Node, lo: str, hi: str) -> unit:
        node.ranges.append(lo)
        node.ranges.append(hi)

    func read_hex(self, fixed: int) -> str:
        var ds = ""
        if self.pp < self.pat.length and self.pat[self.pp] == "{":
            self.pp += 1
            while self.pp < self.pat.length and self.pat[self.pp] != "}":
                ds += self.pat[self.pp]
                self.pp += 1
            if self.pp < self.pat.length:
                self.pp += 1
        else:
            var n = 0
            while n < fixed and self.pp < self.pat.length and is_hex(self.pat[self.pp]):
                ds += self.pat[self.pp]
                self.pp += 1
                n += 1
        return cp_to_str(hex_value(ds))

    func read_name(self, term: str) -> str!:
        var name = ""
        while self.pp < self.pat.length and self.pat[self.pp] != term:
            name += self.pat[self.pp]
            self.pp += 1
        try self.expect(term)
        return name

    func expect(self, ch: str) -> unit!:
        if self.pp < self.pat.length and self.pat[self.pp] == ch:
            self.pp += 1
            return
        error(syntax_error, "expected '" + ch + "' in pattern")

    func skip_ws(self) -> unit:
        while self.pp < self.pat.length:
            let c = self.pat[self.pp]
            if c == " " or c == "\t" or c == "\n" or c == "\r":
                self.pp += 1
            elif c == "#":
                while self.pp < self.pat.length and self.pat[self.pp] != "\n":
                    self.pp += 1
            else:
                break

    # -- matching ------------------------------------------------------------------------------

    ## The leftmost match at or after `offset`, or none. `anchor` is the position `\G` asserts.
    pub func search(self, subject: list[str], offset: int, anchor: int) -> Match?:
        self.subj = subject
        self.len = subject.length
        self.anchor = anchor
        var at = offset
        while at <= self.len:
            self.reset()
            self.caps[0] = at
            if let end = self.match_here(Cont(self.root, 0, none), at):
                self.caps[1] = end
                return self.build()
            at += 1
        return none

    ## A match anchored exactly at `pos` (no scanning), or none.
    pub func match_at(self, subject: list[str], pos: int, anchor: int) -> Match?:
        self.subj = subject
        self.len = subject.length
        self.anchor = anchor
        self.reset()
        self.caps[0] = pos
        if let end = self.match_here(Cont(self.root, 0, none), pos):
            self.caps[1] = end
            return self.build()
        return none

    func reset(self) -> unit:
        self.steps = 0
        var i = 0
        while i < self.caps.length:
            self.caps[i] = -1
            i += 1

    func build(self) -> Match:
        var copy: list[int] = []
        for v in self.caps:
            copy.append(v)
        return Match(copy, self.names)

    func match_here(self, cont: Cont?, pos: int) -> int?:
        self.steps += 1
        if self.steps > self.budget:
            return none
        let frame = cont else return pos
        let node = frame.node
        let rest = frame.next
        if node.kind == K_CHAR:
            if pos < self.len and self.eq(self.subj[pos], node.text):
                return self.match_here(rest, pos + 1)
            return none
        if node.kind == K_ANY:
            if pos < self.len and (self.dotall or self.subj[pos] != "\n"):
                return self.match_here(rest, pos + 1)
            return none
        if node.kind == K_CLASS:
            if pos < self.len and self.class_ok(node, self.subj[pos]):
                return self.match_here(rest, pos + 1)
            return none
        if node.kind == K_ANCHOR:
            if self.anchor_ok(node.a, pos):
                return self.match_here(rest, pos)
            return none
        if node.kind == K_EMPTY:
            return self.match_here(rest, pos)
        if node.kind == K_CONCAT:
            var c = rest
            var i = node.kids.length - 1
            while i >= 0:
                c = Cont(node.kids[i], 0, c)
                i -= 1
            return self.match_here(c, pos)
        if node.kind == K_ALT:
            for branch in node.kids:
                if let r = self.match_here(Cont(branch, 0, rest), pos):
                    return r
            return none
        if node.kind == K_GROUP:
            let idx = node.a
            if idx == 0:
                return self.match_here(Cont(node.kids[0], 0, rest), pos)
            let old = self.caps[2 * idx]
            self.caps[2 * idx] = pos
            let after = Cont(self.closers[idx], 0, rest)
            if let r = self.match_here(Cont(node.kids[0], 0, after), pos):
                return r
            self.caps[2 * idx] = old
            return none
        if node.kind == K_CLOSE:
            let idx = node.a
            let old = self.caps[2 * idx + 1]
            self.caps[2 * idx + 1] = pos
            if let r = self.match_here(rest, pos):
                return r
            self.caps[2 * idx + 1] = old
            return none
        if node.kind == K_REPEAT:
            return self.repeat(node, frame.count, rest, pos)
        if node.kind == K_PROGRESS:
            if pos != frame.count:
                return self.match_here(rest, pos)
            return none
        if node.kind == K_ENDAT:
            if pos == frame.count:
                return self.match_here(rest, pos)
            return none
        if node.kind == K_BACKREF:
            return self.backref(node.a, rest, pos)
        if node.kind == K_LOOK:
            return self.look(node, rest, pos)
        return none

    func repeat(self, node: Node, count: int, rest: Cont?, pos: int) -> int?:
        let child = node.kids[0]
        let lo = node.a
        let hi = node.b
        if count < lo:
            let again = Cont(node, count + 1, rest)
            return self.match_here(Cont(child, 0, again), pos)
        if node.greedy:
            if hi < 0 or count < hi:
                let again = Cont(node, count + 1, rest)
                let guard = Cont(self.prog, pos, again)
                if let r = self.match_here(Cont(child, 0, guard), pos):
                    return r
            return self.match_here(rest, pos)
        if let r = self.match_here(rest, pos):
            return r
        if hi < 0 or count < hi:
            let again = Cont(node, count + 1, rest)
            let guard = Cont(self.prog, pos, again)
            return self.match_here(Cont(child, 0, guard), pos)
        return none

    func backref(self, idx: int, rest: Cont?, pos: int) -> int?:
        let s = self.caps[2 * idx] if 2 * idx + 1 < self.caps.length else -1
        let e = self.caps[2 * idx + 1] if 2 * idx + 1 < self.caps.length else -1
        if s < 0 or e < 0:
            return self.match_here(rest, pos)
        let n = e - s
        if pos + n > self.len:
            return none
        var k = 0
        while k < n:
            if not self.eq(self.subj[pos + k], self.subj[s + k]):
                return none
            k += 1
        return self.match_here(rest, pos + n)

    func look(self, node: Node, rest: Cont?, pos: int) -> int?:
        let child = node.kids[0]
        var ok = false
        if node.ahead:
            if let hit = self.match_here(Cont(child, 0, none), pos):
                ok = hit >= 0
        else:
            let limit = pos - 256 if pos > 256 else 0
            var s = pos
            while s >= limit:
                if let hit = self.match_here(Cont(child, 0, Cont(self.endat, pos, none)), s):
                    ok = hit >= 0
                    break
                s -= 1
        if ok != node.negate:
            return self.match_here(rest, pos)
        return none

    # -- character tests -----------------------------------------------------------------------

    func eq(self, a: str, b: str) -> bool:
        if a == b:
            return true
        if self.ic:
            return swapcase(a) == b
        return false

    func class_ok(self, node: Node, ch: str) -> bool:
        return self.class_hit(node, ch) != node.negate

    func class_hit(self, node: Node, ch: str) -> bool:
        var i = 0
        while i < node.builtins.length:
            let b = node.builtins[i..<i + 1]
            if b == "d" and is_digit(ch):
                return true
            if b == "D" and not is_digit(ch):
                return true
            if b == "w" and is_word(ch):
                return true
            if b == "W" and not is_word(ch):
                return true
            if b == "s" and is_space(ch):
                return true
            if b == "S" and not is_space(ch):
                return true
            if b == "h" and is_hex(ch):
                return true
            if b == "H" and not is_hex(ch):
                return true
            i += 1
        var j = 0
        while j + 1 < node.ranges.length:
            if self.in_range(ch, node.ranges[j], node.ranges[j + 1]):
                return true
            j += 2
        return false

    func in_range(self, ch: str, lo: str, hi: str) -> bool:
        if lo <= ch and ch <= hi:
            return true
        if self.ic:
            let s = swapcase(ch)
            if s != ch and lo <= s and s <= hi:
                return true
        return false

    func anchor_ok(self, kind: int, pos: int) -> bool:
        if kind == AN_BOL:
            return pos == 0 or (self.multi and pos > 0 and self.subj[pos - 1] == "\n")
        if kind == AN_EOL:
            return pos == self.len or (self.multi and pos < self.len and self.subj[pos] == "\n")
        if kind == AN_WORDB:
            return self.word_at(pos - 1) != self.word_at(pos)
        if kind == AN_NWORDB:
            return self.word_at(pos - 1) == self.word_at(pos)
        if kind == AN_BUFS:
            return pos == 0
        if kind == AN_G:
            return pos == self.anchor
        if kind == AN_BUFE:
            return pos == self.len
        return false

    func word_at(self, i: int) -> bool:
        return i >= 0 and i < self.len and is_word(self.subj[i])

# mark: Free helpers ==========================================================================

## The Unicode scalars of `text` as one-scalar strings — the subject form the engine matches.
pub func scalars(text: str) -> list[str]:
    var out: list[str] = []
    for ch in text:
        out.append(ch)
    return out

func is_digit(ch: str) -> bool:
    return "0" <= ch and ch <= "9"

func is_word(ch: str) -> bool:
    return is_digit(ch) or ("a" <= ch and ch <= "z") or ("A" <= ch and ch <= "Z") or ch == "_"

func is_space(ch: str) -> bool:
    return ch == " " or ch == "\t" or ch == "\n" or ch == "\r"

func is_hex(ch: str) -> bool:
    return is_digit(ch) or ("a" <= ch and ch <= "f") or ("A" <= ch and ch <= "F")

func find_in(s: str, ch: str) -> int:
    var i = 0
    while i < s.length:
        if s[i..<i + 1] == ch:
            return i
        i += 1
    return -1

func to_int(digits: str) -> int:
    var value = 0
    for d in digits:
        let n = find_in(digits10, d)
        value = value * 10 + (n if n >= 0 else 0)
    return value

func hex_value(digits: str) -> int:
    var value = 0
    for d in digits:
        value = value * 16 + hex_digit(d)
    return value

func hex_digit(d: str) -> int:
    let a = find_in(digits10, d)
    if a >= 0:
        return a
    let b = find_in("abcdef", d)
    if b >= 0:
        return 10 + b
    let c = find_in("ABCDEF", d)
    if c >= 0:
        return 10 + c
    return 0

func swapcase(ch: str) -> str:
    let u = find_in(UPPER, ch)
    if u >= 0:
        return LOWER[u..<u + 1]
    let l = find_in(LOWER, ch)
    if l >= 0:
        return UPPER[l..<l + 1]
    return ch

## The one-scalar string for a codepoint. The printable ASCII range comes from a table; NUL and
## the whitespace controls are the escapes the Base emitter accepts in a `str`. Every other
## control scalar and any codepoint of 128 or more returns "" — a char that matches nothing —
## until a runtime scalar builder lands (the Luce emitter spells other controls as byte escapes,
## which Base rejects in a text literal). See the README.
func cp_to_str(cp: int) -> str:
    if cp == 9:
        return "\t"
    if cp == 10:
        return "\n"
    if cp == 13:
        return "\r"
    if cp == 0:
        return "\u{0}"
    if cp >= 32 and cp < 127:
        return ASCII_PRINT[cp - 32..<cp - 31]
    return ""

# mark: Tests =================================================================================

func span(pattern: str, text: str) -> str!:
    let re = Regex(pattern)
    let m = re.search(scalars(text), 0, 0) else return "none"
    return str(m.start()) + ":" + str(m.finish())

func ispan(pattern: str, text: str) -> str!:
    let re = Regex(pattern, true)
    let m = re.search(scalars(text), 0, 0) else return "none"
    return str(m.start()) + ":" + str(m.finish())

func gtext(pattern: str, text: str, index: int) -> str!:
    let re = Regex(pattern)
    let m = re.search(scalars(text), 0, 0) else return "none"
    if m.group_start(index) < 0 or m.group_end(index) < 0:
        return "unset"
    return text[m.group_start(index)..<m.group_end(index)]

test "regex literals, classes and anchors":
    assert(span("abc", "xxabcyy") == "2:5")
    assert(span("a.c", "zza-cw") == "2:5")
    assert(span("[0-9]+", "abc123def") == "3:6")
    assert(span("[^0-9]+", "12ab34") == "2:4")
    assert(span("\\d+", "x42") == "1:3")
    assert(span("\\w+", " abc_1 ") == "1:6")
    assert(span("[\\w.]+", "a.b c") == "0:3")
    assert(span("^abc", "abcx") == "0:3")
    assert(span("^abc", "xabc") == "none")
    assert(span("abc$", "abc") == "0:3")
    assert(span("abc$", "abcd") == "none")
    assert(span("a\\.b", "a.b") == "0:3")
    assert(span("a\\.b", "axb") == "none")
    assert(span("", "abc") == "0:0")
    assert(span("[[:digit:]]+", "ab12") == "2:4")

test "regex alternation, quantifiers and word boundaries":
    assert(span("a|bb|ccc", "zzccc") == "2:5")
    assert(span("ab{2,3}c", "abbbc") == "0:5")
    assert(span("ab{2,3}c", "abc") == "none")
    assert(span("ab{2}c", "abbc") == "0:4")
    assert(span("\\bcat\\b", "a cat!") == "2:5")
    assert(span("\\bcat\\b", "concatenate") == "none")
    assert(gtext("a(.*?)b", "axxbxxb", 1) == "xx")
    assert(gtext("a(.*)b", "axxbxxb", 1) == "xxbxx")

test "regex groups, backrefs and lookaround":
    assert(gtext("(ab)+", "ababab", 1) == "ab")
    assert(gtext("(?<word>\\w+)", "  hey ", 1) == "hey")
    assert(span("(ab)\\1", "abab") == "0:4")
    assert(span("(ab)\\1", "abcd") == "none")
    assert(span("foo(?=bar)", "foobar") == "0:3")
    assert(span("foo(?=bar)", "foobaz") == "none")
    assert(span("foo(?!bar)", "foobaz") == "0:3")
    assert(span("foo(?!bar)", "foobar") == "none")
    assert(span("(?<=@)\\w+", "hi @name") == "4:8")
    assert(ispan("abc", "XXABCyy") == "2:5")
    assert(span("abc", "ABC") == "none")
